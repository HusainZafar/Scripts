# Aliases
alias sts="aws sts get-caller-identity"

$ Functions
function dami() {
    local region=$1
    local ami=$2
    aws ec2 describe-images --region $region --image-ids $ami | jq -r ".Images[0].Name"
}

function di() {
    local region=$1
    aws ec2 describe-instances --region $region --filters "Name=instance-state-name,Values=running" | jq -r '.Reservations[].Instances[].InstanceId'
}

function ti() {
    local region=$1
    local instanceId=$2
    aws ec2 terminate-instances --region $region --instance-ids $instanceId | jq -r '.TerminatingInstances[].CurrentState.Name'
}

function tai() {
    local region=${1:-us-west-2}
    for i in $(di $region)
    do
        ti $i $region
    done
}

function ssmc() {
    local instanceId=$1
    local region=${2:-us-west-2}
    aws ssm start-session --target $instanceId --region $region
}
